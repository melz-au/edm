{
  "name": "edm-erd",
  "version": "0.1.0",
  "private": true,
  "description": "Entity relationship diagram viewer for Unity Catalog and Lakebase, deployable as a Databricks App",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 server/*.test.js src/lib/*.test.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@xyflow/react": "^12.12.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.4.4"
  }
}
