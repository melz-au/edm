   "source": [
    "import glob, os, shutil\n",
    "\n",
    "src = os.getcwd()  # the notebook's folder: sample-data/star\n",
    "dst = \"/Volumes/workspace/water_star/raw/\"\n",
    "for f in sorted(glob.glob(f\"{src}/*.csv\")):\n",
    "    shutil.copy(f, dst)\n",
    "    print(\"copied\", os.path.basename(f))"
   ]
  }
